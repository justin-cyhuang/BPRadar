{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/justin-cyhuang/BPRadar/seed-data/control-keywords.schema.json",
  "title": "BPRadar Control Keyword seed data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authoring", "frameworks"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "lastReviewed"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "lastReviewed": { "type": "string", "format": "date" }
      }
    },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frameworkCode", "controls"],
        "properties": {
          "frameworkCode": { "type": "string", "minLength": 1 },
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["controlCode", "keywords"],
              "properties": {
                "controlCode": { "type": "string", "minLength": 1 },
                "keywords": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 5,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 80,
                    "pattern": "^[a-z0-9][a-z0-9 /&+._'-]*[a-z0-9)]$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
