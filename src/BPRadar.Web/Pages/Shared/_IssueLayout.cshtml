<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BPRadar</title>
    <style>
        body { color: #202124; font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 75rem; padding: 0 1rem; }
        .issue-card { border: 1px solid #d0d7de; border-radius: .5rem; margin: 1rem 0; padding: 1rem; }
        .match { border-left: .25rem solid #6e7781; margin-top: 1rem; padding: .75rem 1rem; }
        .match.discrepancy { border-left-color: #cf222e; background: #ffebe9; }
        .match.dismissed { opacity: .7; }
        summary { cursor: pointer; font-weight: 600; }
        button { background: #0969da; border: 0; border-radius: .375rem; color: white; cursor: pointer; font-size: 1rem; margin: .25rem .5rem .25rem 0; padding: .55rem .9rem; }
        .button-secondary { background: #57606a; }
        .confirmation { background: #e7f6ec; border: 1px solid #238636; padding: 1rem; }
        .error { color: #cf222e; }
        .status { background: #fff1cc; border-radius: 1rem; display: inline-block; font-weight: 600; padding: .25rem .75rem; }
        .discrepancy-label { color: #a40e26; font-weight: 700; }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
