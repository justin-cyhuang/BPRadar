<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BPRadar</title>
    <style>
        body { color: #202124; font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 78rem; padding: 0 1rem; }
        fieldset, .card { border: 1px solid #d0d7de; border-radius: .5rem; margin: 1rem 0; padding: 1rem; }
        label { display: block; font-weight: 600; margin-top: .75rem; }
        input:not([type="checkbox"]), select, textarea { box-sizing: border-box; max-width: 42rem; padding: .5rem; width: 100%; }
        textarea { min-height: 5rem; }
        table { border-collapse: collapse; margin-top: 1rem; width: 100%; }
        th, td { border-bottom: 1px solid #d0d7de; padding: .75rem; text-align: left; vertical-align: top; }
        .button, button { background: #0969da; border: 0; border-radius: .375rem; color: white; cursor: pointer; display: inline-block; font-size: 1rem; margin: .4rem .4rem .4rem 0; padding: .6rem 1rem; text-decoration: none; }
        .button-secondary { background: #57606a; }
        .button-danger { background: #cf222e; }
        .confirmation { background: #e7f6ec; border: 1px solid #238636; padding: 1rem; }
        .default-badge { background: #dafbe1; border-radius: 1rem; display: inline-block; font-weight: 600; padding: .2rem .7rem; }
        .validation-summary-errors, .field-validation-error { color: #cf222e; }
        details > summary { cursor: pointer; font-weight: 600; }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
