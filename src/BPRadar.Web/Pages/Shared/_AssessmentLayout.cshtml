<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BPRadar</title>
    <style>
        body { color: #202124; font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 70rem; padding: 0 1rem; }
        fieldset, form { border: 1px solid #d0d7de; border-radius: .5rem; margin: 1rem 0; padding: 1rem; }
        label { display: block; font-weight: 600; margin-top: .75rem; }
        input, select, textarea { box-sizing: border-box; max-width: 40rem; padding: .5rem; width: 100%; }
        table { border-collapse: collapse; margin-top: 1rem; width: 100%; }
        th, td { border-bottom: 1px solid #d0d7de; padding: .75rem; text-align: left; }
        .button, button { background: #0969da; border: 0; border-radius: .375rem; color: white; cursor: pointer; display: inline-block; font-size: 1rem; padding: .65rem 1rem; text-decoration: none; }
        .confirmation { background: #e7f6ec; border: 1px solid #238636; padding: 1rem; }
        .separator { color: #57606a; font-weight: 600; }
        .validation-summary-errors, .field-validation-error { color: #cf222e; }
        .overall-progress { background: #ddf4ff; border-radius: .5rem; padding: 1rem; }
        .domain { border: 1px solid #d0d7de; border-radius: .5rem; margin: 1rem 0; }
        .domain > summary { align-items: center; cursor: pointer; display: flex; font-size: 1.1rem; justify-content: space-between; padding: 1rem; }
        .control-list { border-top: 1px solid #d0d7de; }
        .control-row { padding: 1rem; }
        .control-row:target { background: #fff8c5; outline: 2px solid #bf8700; outline-offset: -2px; }
        .control-row + .control-row { border-top: 1px solid #d8dee4; }
        .control-row header { align-items: start; display: flex; gap: 1rem; justify-content: space-between; }
        .control-row h2 { display: inline; font-size: 1rem; margin: 0 0 0 .5rem; }
        .control-code { color: #57606a; font-family: ui-monospace, monospace; font-weight: 600; }
        .control-fields { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
        .description, .notes { margin: .75rem 0; }
        .description summary, .notes summary { color: #0969da; cursor: pointer; }
        .save-state { color: #1a7f37; font-size: .9rem; }
        .row-error { color: #cf222e; min-height: 1.25rem; }
        .save-row { font-size: .9rem; padding: .45rem .75rem; }
        .app-nav { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
        .app-nav a[aria-current="page"] { font-weight: 700; }
        .scope-selector, .gap-filters { display: grid; gap: 1rem; }
        .checkbox-label { align-items: center; display: flex; gap: .5rem; }
        .checkbox-label input { width: auto; }
        .overview-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
        .overview-card { border: 1px solid #d0d7de; border-radius: .5rem; padding: 1rem; }
        .overview-card h3 { margin-top: 0; }
        .overview-card dl { display: grid; gap: .75rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .overview-card dl div { background: #f6f8fa; border-radius: .375rem; padding: .75rem; }
        .overview-card dt { color: #57606a; font-size: .85rem; }
        .overview-card dd { font-size: 1.1rem; font-weight: 700; margin: .2rem 0 0; }
        .timestamp { color: #57606a; font-size: .85rem; }
        .gap-filters { align-items: end; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); }
        .table-scroll { overflow-x: auto; }
        .gap-row { cursor: pointer; }
        .gap-row:focus { outline: 2px solid #0969da; outline-offset: -2px; }
        .gap-row:hover { background: #f6f8fa; }
        .chart-container { border: 1px solid #d0d7de; border-radius: .5rem; padding: 1rem; }
        .radar-chart, .trend-chart { display: block; height: auto; max-width: 100%; width: 100%; }
        .radar-grid, .radar-axis, .trend-grid { fill: none; stroke: #d8dee4; stroke-width: 1; }
        .radar-grid-label, .trend-label, .trend-date-label { fill: #57606a; font-size: .7rem; }
        .trend-score-label { fill: #24292f; font-size: .7rem; font-weight: 600; }
        .radar-axis-label { fill: #24292f; font-size: .75rem; font-weight: 600; }
        .radar-series { fill: color-mix(in srgb, var(--series-color) 18%, transparent); stroke: var(--series-color); stroke-width: 3; }
        .radar-series.target { --series-color: #57606a; fill: none; stroke-dasharray: 8 5; }
        .radar-target-point { fill: white; stroke: #57606a; stroke-width: 3; }
        .chart-note { color: #57606a; font-size: .85rem; }
        .chart-legend { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; list-style: none; padding: 0; }
        .chart-legend li { align-items: center; display: flex; gap: .4rem; }
        .legend-swatch { background: var(--series-color); display: inline-block; height: .75rem; width: 1.5rem; }
        .legend-swatch.target { background: repeating-linear-gradient(90deg, #57606a 0 6px, transparent 6px 10px); border: 1px solid #57606a; }
        .survey-summary { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
        .survey-summary article { background: #f6f8fa; border-radius: .5rem; padding: 1rem; }
        .survey-summary h4 { color: #57606a; font-size: .85rem; margin: 0 0 .5rem; }
        .survey-summary strong, .survey-summary span { display: block; }
        .survey-summary span { color: #57606a; font-size: .85rem; margin-top: .4rem; }
        .cadence-status { border: 1px solid; border-radius: 1rem; display: inline-block !important; padding: .25rem .65rem; }
        .cadence-on-time { background: #dafbe1; border-color: #4ac26b; color: #116329; }
        .cadence-due-soon { background: #fff8c5; border-color: #d4a72c; color: #633c01; }
        .cadence-overdue { background: #ffebe9; border-color: #ff8182; color: #82071e; }
        .survey-trend-layout { display: grid; gap: 1rem; grid-template-columns: minmax(18rem, 1fr) minmax(24rem, 1.4fr); margin-top: 1rem; }
        .trend-line { fill: none; stroke: #0969da; stroke-linejoin: round; stroke-width: 3; }
        .trend-point { fill: #0969da; stroke: white; stroke-width: 2; }
        @@media (max-width: 50rem) {
            .survey-trend-layout { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <nav class="app-nav" aria-label="Primary">
        <a href="/Dashboard">Dashboard</a>
        <a href="/Assessments">Assessments</a>
    </nav>
    @RenderBody()
</body>
</html>
