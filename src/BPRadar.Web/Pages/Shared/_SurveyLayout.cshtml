<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BPRadar</title>
    <style>
        body { color: #202124; font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 70rem; padding: 0 1rem; }
        fieldset, .survey-card { border: 1px solid #d0d7de; border-radius: .5rem; margin: 1rem 0; padding: 1rem; }
        legend { font-weight: 600; padding: 0 .25rem; }
        li { margin: .75rem 0; }
        textarea { box-sizing: border-box; min-height: 6rem; width: 100%; }
        .button, button { background: #0969da; border: 0; border-radius: .375rem; color: white; cursor: pointer; display: inline-block; font-size: 1rem; padding: .65rem 1rem; text-decoration: none; }
        .confirmation { background: #e7f6ec; border: 1px solid #238636; padding: 1rem; }
        .options { display: grid; gap: .5rem; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); margin-top: .75rem; }
        .required { color: #cf222e; font-size: .9rem; }
        .status { background: #fff1cc; border-radius: 1rem; display: inline-block; font-weight: 600; padding: .25rem .75rem; }
        .submission-summary { display: grid; gap: .5rem 1rem; grid-template-columns: max-content 1fr; }
        .submission-summary dd { margin: 0; }
        .submission-summary dt { font-weight: 600; }
        .table-scroll { overflow-x: auto; }
        table { border-collapse: collapse; width: 100%; }
        th, td { border-bottom: 1px solid #d0d7de; padding: .75rem; text-align: left; vertical-align: top; }
        .validation-summary-errors { background: #ffebe9; border: 1px solid #cf222e; padding: 1rem; }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
