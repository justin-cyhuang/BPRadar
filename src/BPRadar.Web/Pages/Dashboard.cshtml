@page "/Dashboard"
@model BPRadar.Web.Pages.DashboardModel
@using BPRadar.Web.Data
@using BPRadar.Web.Features.Dashboard
@using BPRadar.Web.Features.Surveys
@using Microsoft.AspNetCore.Html
@using System.Globalization
@using static BPRadar.Web.Features.Dashboard.ChartSvgGeometry
@{
    ViewData["Title"] = "Dashboard";
    Layout = "/Pages/Shared/_AssessmentLayout.cshtml";
}

<main>
    <h1>Dashboard</h1>
    <p>Review assessment coverage, compliance, targets, and remediation gaps.</p>

    @if (Model.Organizations.Length == 0)
    {
        <p>No assessments are available. <a href="/Assessments/Create">Create an assessment</a> to begin.</p>
    }
    else
    {
        var dashboard = Model.Dashboard!;
        <form method="get" class="scope-selector">
            <h2>Scope</h2>
            <label>
                Organization
                <select name="OrganizationId" onchange="this.form.submit()">
                    @foreach (var organization in Model.Organizations)
                    {
                        <option
                            value="@organization.Id"
                            selected="@(organization.Id == Model.OrganizationId)">
                            @organization.Name
                        </option>
                    }
                </select>
            </label>

            <fieldset>
                <legend>Assessments</legend>
                @foreach (var assessment in dashboard.AssessmentOptions)
                {
                    var selected = dashboard.SelectedAssessmentIds.Contains(assessment.Id);
                    <label class="checkbox-label">
                        <input
                            type="checkbox"
                            name="AssessmentIds"
                            value="@assessment.Id"
                            checked="@selected" />
                        <span>
                            @assessment.FrameworkName @assessment.FrameworkVersion —
                            @assessment.Label (@assessment.SnapshotDate.ToString("yyyy-MM-dd"))
                        </span>
                    </label>
                }
            </fieldset>

            <label>
                Baseline / Target Profile
                <select name="BaselineProfileId">
                    <option value="">No baseline</option>
                    @foreach (var profile in dashboard.BaselineOptions)
                    {
                        <option
                            value="@profile.Id"
                            selected="@(profile.Id == dashboard.SelectedBaselineProfileId)">
                            @profile.Name@(profile.IsDefault ? " (default)" : "")
                        </option>
                    }
                </select>
            </label>
            <label>
                Survey Template
                <select name="SurveyTemplateId">
                    <option value="">No survey tracking</option>
                    @foreach (var template in dashboard.SurveyTemplateOptions)
                    {
                        <option
                            value="@template.Id"
                            selected="@(template.Id == dashboard.SelectedSurveyTemplateId)">
                            @template.Name (@template.Cadence)
                        </option>
                    }
                </select>
            </label>
            <label class="checkbox-label">
                <input
                    type="checkbox"
                    name="IncludeSurveyDomainDeltas"
                    value="true"
                    checked="@Model.IncludeSurveyDomainDeltas" />
                <span>Include survey domain deltas in CSV</span>
            </label>
            <button type="submit">Apply scope</button>
        </form>

        <section aria-labelledby="exports-heading">
            <h2 id="exports-heading">Audit handoff</h2>
            <p>
                Exports use the current assessment scope and gap filters.
            </p>
            <a class="button" href="@ExportUrl(report: false)">Export CSV</a>
            <a class="button" href="@ExportUrl(report: true)">Print / Save as PDF</a>
        </section>

        <section aria-labelledby="overview-heading">
            <h2 id="overview-heading">Overview</h2>
            @if (dashboard.Overviews.Length == 0)
            {
                <p>Select at least one assessment.</p>
            }
            else
            {
                <div class="overview-grid">
                    @foreach (var overview in dashboard.Overviews)
                    {
                        <article class="overview-card" data-overview-assessment-id="@overview.AssessmentId">
                            <h3>@overview.FrameworkName @overview.FrameworkVersion</h3>
                            <p>@overview.AssessmentLabel</p>
                            <dl>
                                <div>
                                    <dt>Completion</dt>
                                    <dd>@overview.CompletionPercent.ToString("0.#")% completion</dd>
                                </div>
                                <div>
                                    <dt>Compliance</dt>
                                    <dd>@overview.CompliancePercent.ToString("0.#")% compliance</dd>
                                </div>
                                <div>
                                    <dt>Gap count</dt>
                                    <dd>@overview.GapCount gaps</dd>
                                </div>
                                @if (overview.TargetCompliancePercent is not null)
                                {
                                    <div>
                                        <dt>Target</dt>
                                        <dd>@overview.TargetCompliancePercent.Value.ToString("0.#")% target</dd>
                                    </div>
                                    <div>
                                        <dt>Delta</dt>
                                        <dd>@overview.TargetDelta!.Value.ToString("+0.#;-0.#;0")% vs target</dd>
                                    </div>
                                }
                            </dl>
                            <p class="timestamp">
                                Last updated @overview.UpdatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")
                            </p>
                        </article>
                    }
                </div>
            }
        </section>

        <section aria-labelledby="radar-heading">
            <h2 id="radar-heading">Cross-framework comparison</h2>
            @if (dashboard.Radar.Axes.Length == 0)
            {
                <p>Select at least one assessment to display the radar chart.</p>
            }
            else
            {
                var radarColors = new[] { "#0969da", "#8250df", "#1a7f37", "#bf8700", "#cf222e" };
                <div class="chart-container">
                    <svg
                        id="radar-chart"
                        class="radar-chart"
                        viewBox="0 0 600 500"
                        role="img"
                        aria-labelledby="radar-title radar-description">
                        <title id="radar-title">Selected assessment framework scores</title>
                        <desc id="radar-description">
                            Framework axes range from zero to one hundred percent.
                            Each selected assessment is a separate series.
                        </desc>
                        @foreach (var level in dashboard.Radar.GridLevels)
                        {
                            <polygon
                                class="radar-grid"
                                data-grid-level="@level.ToString("0", CultureInfo.InvariantCulture)"
                                points="@RadarGridPoints(dashboard.Radar.Axes.Length, level)" />
                            @SvgText(
                                "radar-grid-label",
                                "304",
                                RadarGridLabelY(level),
                                $"{level.ToString("0", CultureInfo.InvariantCulture)}%")
                        }
                        @for (var index = 0; index < dashboard.Radar.Axes.Length; index++)
                        {
                            var axis = dashboard.Radar.Axes[index];
                            <line
                                class="radar-axis"
                                x1="300"
                                y1="220"
                                x2="@RadarCoordinate(index, dashboard.Radar.Axes.Length, 160, xCoordinate: true)"
                                y2="@RadarCoordinate(index, dashboard.Radar.Axes.Length, 160, xCoordinate: false)" />
                            @SvgText(
                                "radar-axis-label",
                                RadarCoordinate(
                                    index,
                                    dashboard.Radar.Axes.Length,
                                    190,
                                    xCoordinate: true),
                                RadarCoordinate(
                                    index,
                                    dashboard.Radar.Axes.Length,
                                    190,
                                    xCoordinate: false),
                                axis.Label,
                                RadarTextAnchor(index, dashboard.Radar.Axes.Length))
                        }
                        @for (var index = 0; index < dashboard.Radar.Series.Length; index++)
                        {
                            var series = dashboard.Radar.Series[index];
                            var color = radarColors[index % radarColors.Length];
                            <polygon
                                class="radar-series"
                                data-radar-series-assessment-id="@series.AssessmentId"
                                points="@RadarSeriesPoints(series.Values)"
                                style="--series-color: @color" />
                        }
                        @if (dashboard.Radar.TargetSeries is not null)
                        {
                            var targetValues = dashboard.Radar.TargetSeries.Values;
                            @if (targetValues.All(value => value is not null))
                            {
                                <polygon
                                    class="radar-series target"
                                    points="@RadarSeriesPoints(targetValues)" />
                            }
                            else
                            {
                                @for (var index = 0; index < targetValues.Length; index++)
                                {
                                    var targetValue = targetValues[index];
                                    if (targetValue is null)
                                    {
                                        continue;
                                    }

                                    <circle
                                        class="radar-target-point"
                                        data-target-framework-id="@dashboard.Radar.Axes[index].FrameworkId"
                                        cx="@RadarValueCoordinate(
                                            index,
                                            targetValues.Length,
                                            targetValue.Value,
                                            xCoordinate: true)"
                                        cy="@RadarValueCoordinate(
                                            index,
                                            targetValues.Length,
                                            targetValue.Value,
                                            xCoordinate: false)"
                                        r="6">
                                        <title>
                                            @dashboard.Radar.Axes[index].Label target:
                                            @targetValue.Value.ToString("0.#")%
                                        </title>
                                    </circle>
                                }
                            }
                        }
                    </svg>
                    <ul class="chart-legend" aria-label="Radar chart legend">
                        @for (var index = 0; index < dashboard.Radar.Series.Length; index++)
                        {
                            var series = dashboard.Radar.Series[index];
                            var color = radarColors[index % radarColors.Length];
                            <li>
                                <span class="legend-swatch" style="--series-color: @color"></span>
                                <span>@series.Label</span>
                            </li>
                        }
                        @if (dashboard.Radar.TargetSeries is not null)
                        {
                            <li>
                                <span class="legend-swatch target"></span>
                                <span>Target</span>
                            </li>
                        }
                    </ul>
                    @if (dashboard.Radar.TargetSeries?.Values.Any(value => value is null) == true)
                    {
                        <p class="chart-note">
                            Target markers appear only on frameworks with a configured target.
                        </p>
                    }
                </div>
            }
        </section>

        <section aria-labelledby="survey-tracking-heading">
            <h2 id="survey-tracking-heading">Company profile survey tracking</h2>
            @if (dashboard.SelectedSurveyTemplateId is null)
            {
                <p>Select a Survey Template in the scope above to view recurring profile progress.</p>
            }
            else
            {
                var tracking = dashboard.SurveyTracking!;
                <h3>@tracking.SurveyTemplateName</h3>
                <div class="survey-summary">
                    <article>
                        <h4>Latest Self-Reported State</h4>
                        <strong>
                            @(tracking.LatestScore is null
                                ? "No scored submissions"
                                : $"{tracking.LatestScore.Value:0.#}% survey score")
                        </strong>
                    </article>
                    <article>
                        <h4>Self-Reported State change</h4>
                        <strong>
                            @(tracking.LatestDelta is null
                                ? "No previous survey score"
                                : $"{tracking.LatestDelta.Value:+0.#;-0.#;0} points vs previous survey")
                        </strong>
                    </article>
                    <article>
                        <h4>Cadence</h4>
                        <strong>
                            @(tracking.CadenceStatus == SurveyDueStatus.Overdue ? "Overdue" : "On time")
                        </strong>
                        @if (tracking.NextDueDate is not null)
                        {
                            <span>
                                Next due @tracking.NextDueDate.Value.ToString("yyyy-MM-dd")
                            </span>
                        }
                    </article>
                </div>

                @if (tracking.History.Length == 0)
                {
                    <p>No submissions are available for this Organization and Survey Template.</p>
                }
                else
                {
                    <div class="survey-trend-layout">
                        <div class="chart-container">
                            @await Html.PartialAsync(
                                "_SurveyTrendChart",
                                new SurveyTrendChartModel(
                                    "survey-trend",
                                    tracking.Trend))
                        </div>

                        <div class="table-scroll">
                            <h3>Submission history</h3>
                            <table>
                                <thead>
                                    <tr>
                                        <th>Snapshot date</th>
                                        <th>Submission</th>
                                        <th>Profile score</th>
                                        <th>Delta</th>
                                        <th>Key notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var submission in tracking.History)
                                    {
                                        <tr>
                                            <td>@submission.SnapshotDate.ToString("yyyy-MM-dd")</td>
                                            <td>@submission.Label</td>
                                            <td>@(submission.Score?.ToString("0.#") ?? "—")</td>
                                            <td>
                                                @(submission.Delta is null
                                                    ? "—"
                                                    : submission.Delta.Value.ToString("+0.#;-0.#;0"))
                                            </td>
                                            <td>@submission.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (tracking.DomainDeltas.Length > 0)
                {
                    <div class="table-scroll">
                        <h3>Domain changes</h3>
                        <table>
                            <thead>
                                <tr>
                                    <th>Domain</th>
                                    <th>Previous</th>
                                    <th>Latest</th>
                                    <th>Delta</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var domain in tracking.DomainDeltas)
                                {
                                    <tr>
                                        <td>@domain.DomainCode — @domain.DomainName</td>
                                        <td>@domain.PreviousScore.ToString("0.#")</td>
                                        <td>@domain.LatestScore.ToString("0.#")</td>
                                        <td>@domain.Delta.ToString("+0.#;-0.#;0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>

        <section aria-labelledby="gaps-heading">
            <h2 id="gaps-heading">Gap drill-down</h2>
            <form method="get" class="gap-filters">
                <input type="hidden" name="OrganizationId" value="@Model.OrganizationId" />
                @foreach (var assessmentId in dashboard.SelectedAssessmentIds)
                {
                    <input type="hidden" name="AssessmentIds" value="@assessmentId" />
                }
                <input
                    type="hidden"
                    name="BaselineProfileId"
                    value="@dashboard.SelectedBaselineProfileId" />
                <input
                    type="hidden"
                    name="SurveyTemplateId"
                    value="@dashboard.SelectedSurveyTemplateId" />
                <input
                    type="hidden"
                    name="IncludeSurveyDomainDeltas"
                    value="@Model.IncludeSurveyDomainDeltas.ToString().ToLowerInvariant()" />

                <label>
                    Framework
                    <select name="FrameworkId">
                        <option value="">All frameworks</option>
                        @foreach (var framework in dashboard.FrameworkFilters)
                        {
                            <option value="@framework.Id" selected="@(framework.Id == Model.FrameworkId)">
                                @framework.Name @framework.Version
                            </option>
                        }
                    </select>
                </label>
                <label>
                    Domain
                    <select name="DomainId">
                        <option value="">All domains</option>
                        @foreach (var framework in dashboard.FrameworkFilters)
                        {
                            @foreach (var domain in framework.Domains)
                            {
                                <option value="@domain.Id" selected="@(domain.Id == Model.DomainId)">
                                    @framework.Name — @domain.Code @domain.Name
                                </option>
                            }
                        }
                    </select>
                </label>
                <label>
                    Status
                    <select name="GapStatus">
                        <option value="">All gap statuses</option>
                        <option
                            value="Partial"
                            selected="@(Model.GapStatus == ComplianceStatus.Partial)">
                            Partial
                        </option>
                        <option
                            value="NonCompliant"
                            selected="@(Model.GapStatus == ComplianceStatus.NonCompliant)">
                            Non-Compliant
                        </option>
                    </select>
                </label>
                <label>
                    Sort by
                    <select name="Sort">
                        @foreach (var sort in Enum.GetValues<DashboardGapSort>())
                        {
                            <option value="@sort" selected="@(sort == Model.Sort)">@sort</option>
                        }
                    </select>
                </label>
                <label class="checkbox-label">
                    <input
                        type="checkbox"
                        name="SortDescending"
                        value="true"
                        checked="@Model.SortDescending" />
                    <span>Descending</span>
                </label>
                <button type="submit">Apply filters</button>
            </form>

            @if (dashboard.Gaps.Length == 0)
            {
                <p>No gaps match the selected scope and filters.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th>Framework</th>
                                <th>Domain</th>
                                <th>Control Code</th>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Score</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var gap in dashboard.Gaps)
                            {
                                var controlUrl =
                                    $"/Assessments/{gap.AssessmentId}#control-{gap.ControlId}";
                                <tr
                                    class="gap-row"
                                    data-href="@controlUrl"
                                    tabindex="0"
                                    aria-label="Open @gap.ControlCode in @gap.FrameworkName">
                                    <td>@gap.FrameworkName @gap.FrameworkVersion</td>
                                    <td>@gap.DomainCode — @gap.DomainName</td>
                                    <td>
                                        <a href="@controlUrl">
                                            @gap.ControlCode
                                        </a>
                                    </td>
                                    <td>@gap.Title</td>
                                    <td>@(gap.Status == ComplianceStatus.NonCompliant ? "Non-Compliant" : "Partial")</td>
                                    <td>@(gap.Score?.ToString("0.##") ?? "—")</td>
                                    <td>@gap.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</main>

<script>
    document.querySelectorAll(".gap-row").forEach(row => {
        row.addEventListener("click", event => {
            if (!event.target.closest("a")) {
                window.location.assign(row.dataset.href);
            }
        });
        row.addEventListener("keydown", event => {
            if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                window.location.assign(row.dataset.href);
            }
        });
    });
</script>

@functions {
    private string ExportUrl(bool report)
    {
        var dashboard = Model.Dashboard!;
        var parameters = new List<KeyValuePair<string, string?>>
        {
            new("OrganizationId", Model.OrganizationId?.ToString(CultureInfo.InvariantCulture)),
            new(
                "BaselineProfileId",
                dashboard.SelectedBaselineProfileId?.ToString(CultureInfo.InvariantCulture) ??
                string.Empty),
            new(
                "SurveyTemplateId",
                dashboard.SelectedSurveyTemplateId?.ToString(CultureInfo.InvariantCulture)),
            new("FrameworkId", Model.FrameworkId?.ToString(CultureInfo.InvariantCulture)),
            new("DomainId", Model.DomainId?.ToString(CultureInfo.InvariantCulture)),
            new("GapStatus", Model.GapStatus?.ToString()),
            new("Sort", Model.Sort.ToString()),
            new("SortDescending", Model.SortDescending.ToString().ToLowerInvariant())
        };
        parameters.AddRange(
            dashboard.SelectedAssessmentIds.Select(id =>
                new KeyValuePair<string, string?>(
                    "AssessmentIds",
                    id.ToString(CultureInfo.InvariantCulture))));
        if (!report)
        {
            parameters.Add(new("handler", "Csv"));
            parameters.Add(new(
                "IncludeSurveyDomainDeltas",
                Model.IncludeSurveyDomainDeltas.ToString().ToLowerInvariant()));
        }

        var path = report ? "/Dashboard/Report" : "/Dashboard";
        return path + QueryString.Create(parameters);
    }

    private static IHtmlContent SvgText(
        string cssClass,
        string x,
        string y,
        string value,
        string? textAnchor = null)
    {
        var anchor = textAnchor is null
            ? string.Empty
            : $" text-anchor=\"{textAnchor}\"";
        return new HtmlString(
            $"<text class=\"{cssClass}\" x=\"{x}\" y=\"{y}\"{anchor}>" +
            $"{System.Net.WebUtility.HtmlEncode(value)}</text>");
    }
}
